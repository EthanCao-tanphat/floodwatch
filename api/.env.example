# Copy this to .env and fill in real values. NEVER commit .env.

# Required — Dashscope for Qwen-VL depth classification
DASHSCOPE_API_KEY=sk-your-key-here
DASHSCOPE_BASE_URL=https://dashscope-intl.aliyuncs.com/api/v1

# Optional — GraphHopper for real road routing (500 free requests/day)
# Sign up: https://www.graphhopper.com/dashboard
# If unset, /route/safe falls back to straight-line segments.
GRAPHHOPPER_API_KEY=
